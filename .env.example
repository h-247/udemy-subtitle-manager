# ==============================================================================
# Udemy Subtitle Manager - Environment Configuration
# ==============================================================================

# Application Environment
PROJECT_NAME="Udemy Subtitle Manager"
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# For local development with SQLite:
DATABASE_URL=sqlite:///./udemy_subtitles.db
# For PostgreSQL (Docker Compose or local PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/udemy_subtitles

# Security & Session Authentication
# IMPORTANT: Provide a random string with at least 32 characters in production.
SECRET_KEY=udemy-subtitle-manager-secret-key-change-in-production-min-32-chars

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Drive OAuth 2.0 Credentials
# Obtain these from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback
GOOGLE_DRIVE_FOLDER_NAME="Udemy Subtitles"

# Frontend URL (CORS & OAuth redirection)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Subtitle Rate Limiting and Retry Configuration
SUBTITLE_MAX_RETRIES=3
SUBTITLE_RETRY_DELAY=1.0
SUBTITLE_RETRY_BACKOFF_FACTOR=2.0

# Udemy Network Request Configuration
UDEMY_MAX_RETRIES=3
UDEMY_RETRY_DELAY=1.5
UDEMY_REQUEST_TIMEOUT=20.0
